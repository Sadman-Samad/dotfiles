# Backups
*kde-config-backup-*
*.bak
*.bak.*

# OS / editor cruft
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# Machine-specific (regenerated by KDE/xdg-user-dirs)
.config/user-dirs.dirs
.config/user-dirs.locale

# Pip-installed binaries & python cache (auto-generated, not dotfiles)
.local/bin/fonttools
.local/bin/pyftmerge
.local/bin/pyftsubset
.local/bin/ttx
__pycache__/
*.pyc

# Secrets — never commit
.env
.env.*
*.pem
*.key
id_*
known_hosts*
