#!/usr/bin/env bash
# live-wallpaper — set a video wallpaper on KDE Plasma (Wayland).
#
# Drives the installed smart-video-wallpaper plugin
# (luisbocanegra.smart.video.wallpaper.reborn) via the PlasmaShell dbus
# interface. The plugin reads 'VideoUrls' as a JSON array of video objects
# whose 'filename' is a file:// URL. No mpvpaper / hyprctl / wlroots deps.
#
# Usage:
#   live-wallpaper              # random video from WALLPAPER_DIR
#   live-wallpaper video.mp4    # specific video
set -euo pipefail

WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/.local/share/live-wallpapers}"
PLUGIN_ID="luisbocanegra.smart.video.wallpaper.reborn"

# Pick the target video.
if [[ -n "${1:-}" ]]; then
    video="$1"
elif [[ -d "$WALLPAPER_DIR" ]]; then
    video=$(find "$WALLPAPER_DIR" -type f \( -name '*.mp4' -o -name '*.webm' \) | shuf -n 1)
else
    echo "No wallpaper directory: $WALLPAPER_DIR" >&2
    exit 1
fi

[[ -z "${video:-}" ]] && { echo "No video files found in $WALLPAPER_DIR" >&2; exit 1; }

# Resolve to an absolute file:// URL the smart plugin expects.
video=$(readlink -f -- "$video")

# Build the VideoUrls JSON array + the PlasmaShell script in Python (robust
# JSON quoting without shell-escaping gymnastics).
qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
"$(python3 -c '
import json
plugin = "'"$PLUGIN_ID"'"
video  = "'"$video"'"
url    = "file://" + video
vj = json.dumps([{"filename": url, "enabled": True, "loop": True,
                  "playbackRate": 0, "alternativePlaybackRate": 0,
                  "duration": 0, "customDuration": 0}])
js = (
    "var all=desktops();"
    "for(var i=0;i<all.length;i++){"
    "var d=all[i];"
    "d.wallpaperPlugin=" + json.dumps(plugin) + ";"
    "d.currentConfigGroup=Array(\"Wallpaper\"," + json.dumps(plugin) + ",\"General\");"
    "d.writeConfig(\"VideoUrls\"," + json.dumps(vj) + ");"
    "d.reloadConfig();"
    "}"
)
print(js)
')"

echo "Live wallpaper set: $(basename "$video")"
