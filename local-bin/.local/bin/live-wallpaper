#!/usr/bin/env bash
# live-wallpaper — set a video wallpaper on KDE Plasma (Wayland).
#
# Plasma-native: drives the dev.sadman.videowallpaper QML plugin via the
# PlasmaShell dbus interface (QtMultimedia inside plasmashell). No mpvpaper,
# hyprctl, or wlroots dependency — works on KWin.
#
# Usage:
#   live-wallpaper              # random video from WALLPAPER_DIR
#   live-wallpaper video.mp4    # specific video
set -euo pipefail

WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/.local/share/live-wallpapers}"
PLUGIN_ID="dev.sadman.videowallpaper"

# Pick the target video.
if [[ -n "${1:-}" ]]; then
    video="$1"
elif [[ -d "$WALLPAPER_DIR" ]]; then
    video=$(find "$WALLPAPER_DIR" -type f \( -name '*.mp4' -o -name '*.webm' \) | shuf -n 1)
else
    echo "No wallpaper directory: $WALLPAPER_DIR" >&2
    exit 1
fi

[[ -z "${video:-}" ]] && { echo "No video files found in $WALLPAPER_DIR" >&2; exit 1; }

# Resolve to an absolute path the QML MediaPlayer can load.
video=$(readlink -f -- "$video")

# Build the PlasmaShell script. JSON-encode the path to stay safe against
# quotes/backslashes, then write it into every desktop containment.
path_json=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$video")

qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
"var all=desktops();
for(var i=0;i<all.length;i++){
  var d=all[i];
  d.wallpaperPlugin='$PLUGIN_ID';
  d.currentConfigGroup=Array('Wallpaper','$PLUGIN_ID','General');
  d.writeConfig('VideoSource',$path_json);
  d.writeConfig('Running','true');
  d.writeConfig('Muted','true');
  d.reloadConfig();
}" >/dev/null

echo "Live wallpaper set: $(basename "$video")"
