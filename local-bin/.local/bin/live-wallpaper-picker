def guess_gender(title: str) -> str:
    t = title.lower()
    if any(k in t for k in FEMALE_KW if k):
        return "female"
    if any(k in t for k in MALE_KW if k):
        return "male"
    return "unknown"

GENDER_FILTERS = {
    "all":     "All",
    "female":  "♀ Female",
    "male":    "♂ Male",
    "unknown": "❓ Other",
}


# ─── Helpers ───────────────────────────────────────────────────────────────
def generate_thumbnail(video_path: Path):
    thumb = THUMB_DIR / (video_path.stem + ".png")
    if thumb.exists():
        return thumb
    try:
        subprocess.run(
            ["ffmpeg", "-y", "-ss", "00:00:01", "-i", str(video_path),
             "-frames:v", "1", "-vf", "scale=320:-1", str(thumb)],
            capture_output=True, timeout=10)
        return thumb if thumb.exists() else None
    except Exception:
        return None

def _plasma_eval(js: str, retries: int = 3):
    """Run a JavaScript snippet against the running PlasmaShell via dbus.

    Retries: plasmashell intermittently fails evaluateScript (exit 2) while
    a video wallpaper is being torn down or the shell is busy; a retry
    after a short wait succeeds.
    """
    last_err = None
    for attempt in range(retries):
        try:
            return subprocess.check_output(
                ["qdbus6", "org.kde.plasmashell", "/PlasmaShell",
                 "org.kde.PlasmaShell.evaluateScript", js],
                text=True, timeout=10).strip()
        except subprocess.CalledProcessError as e:
            last_err = e
            time.sleep(1 + attempt)  # 1s, 2s before retry
    raise last_err

SMART_PLUGIN = "luisbocanegra.smart.video.wallpaper.reborn"

def set_wallpaper(video_path: str):
    """Apply a video wallpaper on KDE Plasma.

    Drives the installed smart-video-wallpaper plugin
    (luisbocanegra.smart.video.wallpaper.reborn) via the PlasmaShell dbus
    interface. The plugin reads 'VideoUrls' as a JSON array of video objects
    whose 'filename' is a file:// URL. This renders correctly on Plasma 6 /
    Wayland (NVIDIA), unlike a from-scratch QtMultimedia wallpaper.
    """
    url = "file://" + str(Path(video_path).expanduser().resolve())
    video_json = json.dumps([{
        "filename": url, "enabled": True, "loop": True,
        "playbackRate": 0, "alternativePlaybackRate": 0,
        "duration": 0, "customDuration": 0,
    }])
    plugin = SMART_PLUGIN
    # The payload string is embedded as a json.dumps'd JS string literal —
    # QJS accepts double quotes fine; it was NESTED unescaped quotes that
    # caused SyntaxError. json.dumps output needs no re-quoting.
    js = (
        "var all = desktops();"
        "for (var i = 0; i < all.length; i++) {"
        "  var d = all[i];"
 f"  d.wallpaperPlugin = {json.dumps(plugin)};"
        "  d.currentConfigGroup = Array('Wallpaper',"
 f" {json.dumps(plugin)}, 'General');"
 f"  d.writeConfig('VideoUrls', {json.dumps(video_json)});"
        "  d.reloadConfig();"
        "}"
    )
    _plasma_eval(js)

def get_applied_wallpaper() -> str:
    """Return the path of the currently applied video wallpaper ('' if none).

    Reads the smart plugin's VideoUrls config back from the running Plasma
    desktop via dbus. Non-fatal when plasmashell is down: no indicator.
    """
    try:
        raw = _plasma_eval(
            "var d = desktops()[0];"
            "d.currentConfigGroup = Array('Wallpaper', "
            f"{json.dumps(SMART_PLUGIN)}, 'General');"
            "print(d.readConfig('VideoUrls'));")
        entries = json.loads(raw) if raw else []
        for e in entries:
            f = e.get("filename", "")
            if f.startswith("file://") and Path(f[7:]).exists():
                return str(Path(f[7:]).resolve())
        return ""
    except Exception:
        return ""

def local_path_for(slug: str) -> Path:
    """Local file path a MoeWalls slug downloads to."""
    return WALLPAPER_DIR / f"{slug}.mp4"

def fetch_page(category: str, page: int):
    """Fetch one page of wallpapers from a MoeWalls category. Returns list of dicts."""
    if category == "all":
        # Fetch from multiple categories in parallel, then interleave
        # round-robin so the grid shows variety instead of 16 anime first.
        per_cat = {}   # cat → list of wallpaper dicts
        threads = []
        lock = threading.Lock()
        all_cats = ["anime", "games", "movies", "fantasy", "sci-fi", "landscape"]

        def _fetch_cat(cat):
            url = f"https://moewalls.com/category/{cat}/page/{page}/" if page > 1 else f"https://moewalls.com/category/{cat}/"
            try:
                req = urllib.request.Request(url,
                        headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
                html = urllib.request.urlopen(req, timeout=15).read().decode("utf-8", "replace")
                parsed = parse_category_html(html, cat)
                with lock:
                    per_cat[cat] = parsed
            except Exception:
                with lock:
                    per_cat[cat] = []

        for cat in all_cats:
            t = threading.Thread(target=_fetch_cat, args=(cat,), daemon=True)
            threads.append(t)
            t.start()
        for t in threads:
            t.join()

        # Round-robin: take one from each category in turn
        results = []
        max_len = max((len(v) for v in per_cat.values()), default=0)
        for i in range(max_len):
            for cat in all_cats:
                items = per_cat.get(cat, [])
                if i < len(items):
                    results.append(items[i])
        return results
    else:
        url = (f"https://moewalls.com/category/{category}/page/{page}/"
               if page > 1 else f"https://moewalls.com/category/{category}/")
        try:
            req = urllib.request.Request(url,
                    headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
            html = urllib.request.urlopen(req, timeout=15).read().decode("utf-8", "replace")
            return parse_category_html(html, category)
        except Exception:
            return []

def parse_category_html(html: str, category: str):
    """Parse a MoeWalls category page for wallpaper entries.

    Wallpapers live inside <article> blocks. Parsing the full page HTML
    instead also matches resolution links, sidebar entries, and ads —
    which produce blank cards with no thumbnails.
    """
    articles = re.findall(r'<article[^>]*>(.*?)</article>', html, re.DOTALL)
    seen, results = set(), []
    for art in articles:
        link_m = re.search(
            r'href="(https://moewalls\.com/(?:[a-z-]+)/([^/]+)/?)"', art)
        thumb_m = re.search(r'src="(https://[^"]+-thumb[^"]*\.jpg)"', art)
        if not link_m:
            continue
        page_url, slug = link_m.group(1), link_m.group(2)
        if slug in seen:
            continue
        seen.add(slug)
        title = slug.replace("-", " ").title().replace(" Live Wallpaper", "")
        results.append({"title": title, "slug": slug, "page_url": page_url,
                        "thumb_url": thumb_m.group(1) if thumb_m else "",
                        "category": category, "gender": guess_gender(title)})
    return results

def download_online_wallpaper(wallpaper: dict, progress_cb=None):
    """Download via go.moewalls.com/download.php?video=<token>."""
    try:
        req = urllib.request.Request(wallpaper["page_url"],
                headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
        html = urllib.request.urlopen(req, timeout=15).read().decode("utf-8", "replace")
    except Exception:
        return None

    # The download button: <a id="moe-download" data-id="..." data-url="<token>">
    m = re.search(r'id="moe-download"[^>]*data-url="([^"]+)"', html)
    if not m:
        return None
    token = m.group(1)
    dl_url = f"https://go.moewalls.com/download.php?video={token}"

    out = WALLPAPER_DIR / f"{wallpaper['slug']}.mp4"
    try:
        req = urllib.request.Request(dl_url, headers={
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64)",
            "Referer": "https://moewalls.com/"})
        resp = urllib.request.urlopen(req, timeout=120)
        total = int(resp.headers.get("Content-Length", 0))

        # Stream to disk with optional progress callback
        tmp = out.with_suffix(".mp4.part")
        downloaded = 0
        with open(tmp, "wb") as f:
            while True:
                chunk = resp.read(65536)
                if not chunk:
                    break
                f.write(chunk)
                downloaded += len(chunk)
                if progress_cb and total:
                    progress_cb(downloaded, total)
        tmp.rename(out)
        return out
    except Exception:
        if out.with_suffix(".mp4.part").exists():
            out.with_suffix(".mp4.part").unlink(missing_ok=True)
        return None


# ─── Cards ─────────────────────────────────────────────────────────────────
class LocalCard(Gtk.Box):
    def __init__(self, video_path: Path, picker):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.set_name("wallpaper-card")
        self.video_path = video_path
        self.picker = picker

        pic = Gtk.Picture()
        pic.set_size_request(CARD_W, CARD_H)
        pic.set_content_fit(Gtk.ContentFit.FILL)
        self.append(pic)
        self._pic = pic
        threading.Thread(target=self._gen_thumb, args=(video_path,), daemon=True).start()

        name = video_path.stem.replace("-", " ").replace("_", " ").title()
        if len(name) > 26: name = name[:23] + "…"
        lbl = Gtk.Label(label=name)
        lbl.set_max_width_chars(24)
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        self.append(lbl)

        self.btn = Gtk.Button(label="Apply")
        self.btn.set_css_classes(["suggested-action"])
        self.btn.connect("clicked", self._on_apply)
        self.append(self.btn)
        self.refresh_state(picker._applied)

    def refresh_state(self, applied: str = ""):
        """Update button/card for currently-applied wallpaper."""
        is_applied = applied == str(self.video_path.resolve())
        self.btn.set_label("✓ Applied" if is_applied else "Apply")
        self.btn.set_css_classes([] if is_applied else ["suggested-action"])
        self.set_css_classes(["card-applied"] if is_applied else [])

    def _on_apply(self, *_):
        self.btn.set_label("⏳ Applying…")
        self.btn.set_sensitive(False)
        def _bg():
            try:
                set_wallpaper(str(self.video_path))
                ok = True
            except Exception:
                ok = False
            def _ui():
                self.btn.set_sensitive(True)
                if ok:
                    self.picker.toast(f"Set: {self.video_path.stem}")
                    self.picker.refresh_all_states()
                else:
                    self.picker.toast("Failed to set wallpaper")
                return False
            GLib.idle_add(_ui)
        threading.Thread(target=_bg, daemon=True).start()

    def _gen_thumb(self, vp):
        thumb = generate_thumbnail(vp)
        if thumb:
            GLib.idle_add(self._set_pix, str(thumb))

    def _set_pix(self, path):
        try:
            self._pic.set_paintable(
                Gdk.Texture.new_from_file(Gio.File.new_for_path(path)))
        except Exception:
            pass


class OnlineCard(Gtk.Box):
    def __init__(self, wallpaper: dict, picker):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.set_name("wallpaper-card")
        self.wp = wallpaper
        self.picker = picker
        self.done = False

        pic = Gtk.Picture()
        pic.set_size_request(CARD_W, CARD_H)
        pic.set_content_fit(Gtk.ContentFit.FILL)
        self.append(pic)
        self._pic = pic
        threading.Thread(target=self._load_thumb, daemon=True).start()

        # Title + gender badge row
        self._title_box = title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        title = wallpaper["title"]
        if len(title) > 20: title = title[:17] + "…"
        lbl = Gtk.Label(label=title)
        lbl.set_max_width_chars(20)
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_hexpand(True)
        title_box.append(lbl)

        gender = wallpaper.get("gender", "unknown")
        if gender != "unknown":
            badge = Gtk.Label(label="♀" if gender == "female" else "♂")
            badge.set_css_classes(["gender-badge", f"gender-{gender}"])
            title_box.append(badge)

        # 'On disk' badge when the mp4 already exists locally
        self._dl_badge = None
        if local_path_for(wallpaper["slug"]).exists():
            self._dl_badge = Gtk.Label(label="⬇ saved")
            self._dl_badge.set_css_classes(["badge-downloaded"])
            self._dl_badge.set_tooltip_text(
                f"Already downloaded: {local_path_for(wallpaper['slug'])}")
            title_box.append(self._dl_badge)
        self.append(title_box)

        self.btn = Gtk.Button(label="⬇ Download & Apply")
        self.btn.set_css_classes(["suggested-action"])
        self.btn.connect("clicked", self._on_dl)
        self.append(self.btn)
        self.refresh_state(self.picker._applied)

    def refresh_state(self, applied: str):
        """Sync button/classes with on-disk + currently-applied state."""
        local = local_path_for(self.wp["slug"])
        on_disk = local.exists()
        is_applied = on_disk and applied == str(local.resolve())
        if is_applied:
            self.btn.set_label("✓ Applied")
            self.btn.set_css_classes([])
            self.set_css_classes(["card-applied"])
        elif on_disk:
            self.btn.set_label("▶ Apply")
            self.btn.set_css_classes(["suggested-action"])
            self.set_css_classes(["card-downloaded"])
        else:
            self.btn.set_label("⬇ Download & Apply")
            self.btn.set_css_classes(["suggested-action"])
            self.set_css_classes([])
        if on_disk and self._dl_badge is None and self._title_box is not None:
            self._dl_badge = Gtk.Label(label="⬇ saved")
            self._dl_badge.set_css_classes(["badge-downloaded"])
            self._dl_badge.set_tooltip_text(f"Already downloaded: {local}")
            self._title_box.append(self._dl_badge)

    def _load_thumb(self):
        p = ONLINE_CACHE / f"{self.wp['slug']}.jpg"
        if not p.exists():
            try:
                req = urllib.request.Request(self.wp["thumb_url"],
                        headers={"User-Agent": "Mozilla/5.0"})
                p.write_bytes(urllib.request.urlopen(req, timeout=10).read())
            except Exception:
                return
        GLib.idle_add(self._set_pix, str(p))

    def _set_pix(self, path):
        try:
            self._pic.set_paintable(
                Gdk.Texture.new_from_file(Gio.File.new_for_path(path)))
        except Exception:
            pass

    def _on_dl(self, _):
        if self.done: return
        local = local_path_for(self.wp["slug"])
        if local.exists():
            # Already on disk — just apply, no re-download.
            self.btn.set_label("⏳ Applying…")
            self.btn.set_sensitive(False)
            threading.Thread(target=self._apply_local, daemon=True).start()
            return
        self.btn.set_label("⏳ 0%")
        self.btn.set_sensitive(False)
        threading.Thread(target=self._dl_thread, daemon=True).start()

    def _apply_local(self):
        try:
            set_wallpaper(str(local_path_for(self.wp["slug"])))
            GLib.idle_add(self._dl_done, local_path_for(self.wp["slug"]))
        except Exception:
            GLib.idle_add(self._dl_done, None)

    def _dl_thread(self):
        def progress(done, total):
            pct = int(done * 100 / total) if total else 0
            GLib.idle_add(self.btn.set_label, f"⏳ {pct}%")
        res = download_online_wallpaper(self.wp, progress_cb=progress)
        if res:
            # Download done — now actually apply it (same path as local apply).
            try:
                set_wallpaper(str(res))
            except Exception:
                res = None
        GLib.idle_add(self._dl_done, res)

    def _dl_done(self, res):
        if res:
            self.done = True
            self.picker.refresh_all_states()
            self.picker.toast(f"Applied: {res.stem}")
        else:
            self.btn.set_label("↻ Retry")
            self.btn.set_sensitive(True)
            self.picker.toast("Download failed")


# ─── Main window ───────────────────────────────────────────────────────────
class PickerWindow(Adw.ApplicationWindow):
    def __init__(self, **kw):
        super().__init__(**kw)
        self.set_title("Live Wallpaper Picker")
        self.set_default_size(1000, 700)

        self._all_online = []   # all fetched wallpapers
        self._cur_cat = "all"
        self._cur_gender = "all"
        self._applied = get_applied_wallpaper()  # cached; refreshed on apply

        toast_ovl = Adw.ToastOverlay()
        self.set_content(toast_ovl)
        self._toast = toast_ovl

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        toast_ovl.set_child(box)

        # ── Header ──
        hdr = Adw.HeaderBar()
        box.append(hdr)

        rbtn = Gtk.Button(icon_name="view-refresh-symbolic")
        rbtn.set_tooltip_text("Refresh")
        rbtn.connect("clicked", self._on_refresh)
        hdr.pack_start(rbtn)

        sbtn = Gtk.Button(icon_name="media-playlist-shuffle-symbolic")
        sbtn.set_tooltip_text("Random local wallpaper")
        sbtn.connect("clicked", self._random)
        hdr.pack_start(sbtn)

        # Currently applied wallpaper strip
        self.applied_lbl = Gtk.Label(label="")
        self.applied_lbl.set_css_classes(["dim-label"])
        self.applied_lbl.set_ellipsize(Pango.EllipsizeMode.END)
        self.applied_lbl.set_max_width_chars(60)
        self.applied_lbl.set_margin_bottom(6)
        box.append(self.applied_lbl)

        self.stack = Adw.ViewStack()
        sw = Adw.ViewSwitcher()
        sw.set_policy(Adw.ViewSwitcherPolicy.WIDE)
        sw.set_stack(self.stack)
        box.append(sw)
        box.append(self.stack)

        # ── Local tab ──
        ls = Gtk.ScrolledWindow(vexpand=True)
        self.lf = Gtk.FlowBox(max_children_per_line=4, min_children_per_line=2,
                homogeneous=True, selection_mode=Gtk.SelectionMode.NONE,
                margin_start=12, margin_end=12, margin_top=12, margin_bottom=12,
                row_spacing=12, column_spacing=12)
        ls.set_child(self.lf)
        pg = self.stack.add_titled(child=ls, name="local", title="Local")
        pg.set_icon_name("folder-pictures-symbolic")

        # ── Online tab (with filter bar) ──
        online_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        online_box.set_vexpand(True)

        # Filter bar: Category dropdown + Gender dropdown + Load More
        filter_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                             margin_start=12, margin_end=12, margin_top=8, margin_bottom=8)

        # Category dropdown
        cat_model = Gtk.StringList.new(list(CATEGORIES.values()))
        self.cat_dropdown = Gtk.DropDown(model=cat_model)
        self.cat_dropdown.set_tooltip_text("Category")
        self.cat_dropdown.connect("notify::selected", self._on_cat_changed)
        filter_bar.append(self.cat_dropdown)

        # Gender dropdown
        gender_model = Gtk.StringList.new(list(GENDER_FILTERS.values()))
        self.gender_dropdown = Gtk.DropDown(model=gender_model)
        self.gender_dropdown.set_tooltip_text("Gender filter")
        self.gender_dropdown.connect("notify::selected", self._on_gender_changed)
        filter_bar.append(self.gender_dropdown)

        # Load more button
        self.more_btn = Gtk.Button(label="Load More")
        self.more_btn.set_css_classes(["suggested-action"])
        self.more_btn.connect("clicked", self._on_load_more)
        filter_bar.append(self.more_btn)

        # Result count label
        self.count_lbl = Gtk.Label(label="")
        self.count_lbl.set_css_classes(["dim-label"])
        self.count_lbl.set_hexpand(True)
        self.count_lbl.set_halign(Gtk.Align.END)
        filter_bar.append(self.count_lbl)

        online_box.append(filter_bar)

        os = Gtk.ScrolledWindow(vexpand=True)
        self.of = Gtk.FlowBox(max_children_per_line=4, min_children_per_line=2,
                homogeneous=True, selection_mode=Gtk.SelectionMode.NONE,
                margin_start=12, margin_end=12, margin_top=4, margin_bottom=12,
                row_spacing=12, column_spacing=12)
        os.set_child(self.of)
        online_box.append(os)

        pg = self.stack.add_titled(child=online_box, name="online", title="Online")
        pg.set_icon_name("network-server-symbolic")

        # Loading placeholder
        self._loading_lbl = Gtk.Label(label="Loading trending wallpapers…",
                        margin_top=40, css_classes=["dim-label"])
        self.of.append(self._loading_lbl)

        self._page = 1
        name = (Path(self._applied).stem.replace("-", " ").title()
                if self._applied else "none")
        self.applied_lbl.set_label(f"Current wallpaper: {name}")
        self._fill_local()
        threading.Thread(target=self._fetch_online, args=(1, INITIAL_PAGES),
                         daemon=True).start()

    def _fill_local(self):
        c = self.lf.get_first_child()
        while c:
            nxt = c.get_next_sibling()
            self.lf.remove(c)
            c = nxt
        vids = sorted(WALLPAPER_DIR.glob("*.mp4")) + sorted(WALLPAPER_DIR.glob("*.webm"))
        if not vids:
            self.lf.append(Adw.StatusPage(title="No local wallpapers",
                description=f"Add videos to {WALLPAPER_DIR}"))
            return
        for v in vids:
            self.lf.append(LocalCard(v, self))

    def _fetch_online(self, page: int, pages: int = 1):
        """Fetch `pages` consecutive pages; deliver as one combined batch."""
        wps, consumed = [], 0
        for p in range(page, page + pages):
            batch = fetch_page(self._cur_cat, p)
            if not batch:
                break
            wps.extend(batch)
            consumed += 1

        def _deliver():
            self._page = page + consumed   # first unfetched page
            self._on_fetched(wps, page)
        GLib.idle_add(_deliver)

    def _on_fetched(self, wps, page):
        if page == 1:
            # Clear existing + remove loading label
            c = self.of.get_first_child()
            while c:
                nxt = c.get_next_sibling()
                self.of.remove(c)
                c = nxt
            self._all_online = []

        # Deduplicate
        existing = {w["slug"] for w in self._all_online}
        for w in wps:
            if w["slug"] not in existing:
                self._all_online.append(w)
                existing.add(w["slug"])

        self._apply_filters()

        if not wps and page == 1:
            self.of.append(Adw.StatusPage(title="Connection failed",
                description="Could not fetch wallpapers. Check your internet."))
            self.more_btn.set_sensitive(False)
        elif not wps:
            self.more_btn.set_sensitive(False)
            self.more_btn.set_label("No more")
        else:
            self.more_btn.set_sensitive(True)
            self.more_btn.set_label("Load More")

    def _apply_filters(self):
        """Re-filter the grid by current category + gender without refetching."""
        c = self.of.get_first_child()
        while c:
            nxt = c.get_next_sibling()
            self.of.remove(c)
            c = nxt

        gender = self._cur_gender
        filtered = [w for w in self._all_online
                    if gender == "all" or w.get("gender") == gender]

        for w in filtered:
            self.of.append(OnlineCard(w, self))

        self.count_lbl.set_label(f"{len(filtered)} wallpapers")

    def _on_cat_changed(self, dropdown, _param):
        idx = dropdown.get_selected()
        self._cur_cat = list(CATEGORIES.keys())[idx]
        self._page = 1
        # Clear and show loading
        c = self.of.get_first_child()
        while c:
            nxt = c.get_next_sibling()
            self.of.remove(c)
            c = nxt
        self.of.append(Gtk.Label(label=f"Loading {CATEGORIES[self._cur_cat]}…",
                        margin_top=40, css_classes=["dim-label"]))
        self.more_btn.set_sensitive(False)
        threading.Thread(target=self._fetch_online, args=(1, INITIAL_PAGES),
                         daemon=True).start()

    def _on_gender_changed(self, dropdown, _param):
        idx = dropdown.get_selected()
        self._cur_gender = list(GENDER_FILTERS.keys())[idx]
        self._apply_filters()

    def _on_load_more(self, _):
        self._page += 1
        self.more_btn.set_label("Loading…")
        self.more_btn.set_sensitive(False)
        threading.Thread(target=self._fetch_online, args=(self._page,), daemon=True).start()

    def refresh_all_states(self):
        """Re-read the applied wallpaper (off-UI) and update every card."""
        def _bg():
            applied = get_applied_wallpaper()
            def _ui():
                self._applied = applied
                name = (Path(applied).stem.replace("-", " ").title()
                        if applied else "none")
                self.applied_lbl.set_label(f"Current wallpaper: {name}")
                for flow in (self.lf, self.of):
                    child = flow.get_first_child()
                    while child:
                        card = (child.get_child()
                                if hasattr(child, "get_child") else child)
                        if hasattr(card, "refresh_state"):
                            card.refresh_state(self._applied)
                        child = child.get_next_sibling()
                return False
            GLib.idle_add(_ui)
        threading.Thread(target=_bg, daemon=True).start()

    def _on_refresh(self, _):
        self._fill_local()
        self.refresh_all_states()
        self.toast("Refreshed")
        self._page = 1
        threading.Thread(target=self._fetch_online, args=(1, INITIAL_PAGES),
                         daemon=True).start()

    def _random(self, _):
        vids = sorted(WALLPAPER_DIR.glob("*.mp4")) + sorted(WALLPAPER_DIR.glob("*.webm"))
        if vids:
            ch = random.choice(vids)
            set_wallpaper(str(ch))
            self.toast(f"Random: {ch.stem}")
            self.refresh_all_states()

    def toast(self, msg):
        t = Adw.Toast.new(msg)
        t.set_timeout(3)
        self._toast.add_toast(t)


# ─── App ───────────────────────────────────────────────────────────────────
class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="dev.sadman.LiveWallpaperPicker")
        self.style_manager = self.get_style_manager()
        self.style_manager.set_color_scheme(Adw.ColorScheme.FORCE_DARK)

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = self.props.active_window
        if not win:
            win = PickerWindow(application=self)
        win.present()


def main():
    App().run(sys.argv)

if __name__ == "__main__":
    main()
