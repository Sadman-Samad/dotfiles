#!/usr/bin/env python3
"""
live-wallpaper-picker — browse and pick live wallpapers.

Local tab: grid of thumbnails for videos in ~/.local/share/live-wallpapers/.
Online tab: trending wallpapers from MoeWalls with category filter.
"""
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

import sys, random, subprocess, threading, urllib.request, re, json
from pathlib import Path
from gi.repository import Gtk, Adw, GLib, Gdk, Gio, Pango

WALLPAPER_DIR = Path.home() / ".local" / "share" / "live-wallpapers"
THUMB_DIR     = Path.home() / ".cache" / "live-wallpaper-thumbs"
ONLINE_CACHE  = Path.home() / ".cache" / "live-wallpaper-online"
for d in (WALLPAPER_DIR, THUMB_DIR, ONLINE_CACHE):
    d.mkdir(parents=True, exist_ok=True)

CARD_W, CARD_H = 200, 120
PAGE_SIZE = 2  # pages to fetch per category

# MoeWalls categories: slug → display name
CATEGORIES = {
    "all":      "🔥 All",
    "anime":    "✨ Anime",
    "games":    "🎮 Games",
    "movies":   "🎬 Movies",
    "abstract": "🎨 Abstract",
    "fantasy":  "🐉 Fantasy",
    "sci-fi":   "🚀 Sci-Fi",
    "landscape":"🏞️ Landscape",
    "animal":   "🐾 Animals",
    "vehicle":  "🚗 Vehicles",
    "pixel-art":"👾 Pixel Art",
    "lifestyle":"☕ Lifestyle",
    "others":   "📦 Others",
}

