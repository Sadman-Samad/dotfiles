// Bottom bar — workspaces + taskbar + launcher

{
  "layer": "top",
  "exclusive": true,
  "position": "bottom",
  "height": 52,
  "spacing": 4,
  "margin-top": 0,
  "margin-bottom": 4,
  "margin-left": 6,
  "margin-right": 6,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "idle_inhibitor",
    "custom/launcher"
  ],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "urgent": "",
      "default": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 32,
    "all-outputs": false,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [],
    "rewrite": {
      "Kitty": "󰄛 Kitty",
      "kitty": "󰄛 Kitty",
      "Chromium": "󰊯 Chromium",
      "chromium": "󰊯 Chromium",
      "Code": "󰨞 Code",
      "Spotify": "󰓇 Spotify",
      "Firefox": "󰈹 Firefox",
      "Gimp": "󰋩 GIMP",
      "Discord": "󰙯 Discord",
      "Steam": "󰓓 Steam"
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰒳",
      "deactivated": "󰒲"
    },
    "tooltip": false
  },

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "sh -c 'pgrep walker >/dev/null && pkill walker || walker'"
  }
}
