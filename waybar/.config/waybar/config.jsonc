{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "custom/weather",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "default": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "rewrite": {
      "(.*) — Mozilla Firefox": " $1",
      "(.*) — Kitty": " $1"
    }
  },

  "clock": {
    "format": " {:%I:%M %p}",
    "format-alt": " {:%a %b %d · %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#b4befe'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#a6adc8'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#ffcead'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " Connected",
    "format-disconnected": " Disconnected",
    "tooltip-format": "{ifname} — {ipaddr} · ↓ {bandwidthDownBits} ↑ {bandwidthUpBits}",
    "max-length": 28
  },

  "disk": {
    "path": "/",
    "interval": 30,
    "format": "󰎈 {percentage_used}%",
    "tooltip-format": "{path} — {free} free of {total}"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip": false
  },

  "memory": {
    "format": "󰍚 {percentage}%",
    "interval": 10
  },

  "temperature": {
    "thermal-zone": 0,
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "format": " {temperatureC}°C",
    "critical-threshold": 80,
    "format-critical": "\uf2c8 {temperatureC}°C"
  },

  "tray": {
    "spacing": 10
  },
  "custom/weather": {
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "interval": 600,
    "exec": "~/.config/waybar/scripts/wttr.sh",
    "exec-if": "command -v curl >/dev/null",
    "return-on-failure": false
  },


  "custom/power": {
    "format": "",
    "on-click": "wofi-logout",
    "tooltip": false
  }
}
