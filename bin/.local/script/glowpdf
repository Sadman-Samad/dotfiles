#!/usr/bin/env python3
"""glowpdf - md -> glow-style dark PDF. usage: glowpdf input.md [output.pdf]"""
import sys, subprocess
from pathlib import Path
import markdown

def find_chrome():
    import shutil
    candidates = [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/usr/bin/google-chrome", "/usr/bin/google-chrome-stable",
        "/usr/bin/chromium", "/usr/bin/chromium-browser",
    ]
    for c in candidates:
        if Path(c).exists():
            return c
    for b in ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser"]:
        p = shutil.which(b)
        if p:
            return p
    return None

def main():
    if len(sys.argv) < 2:
        print("usage: glowpdf input.md [output.pdf]"); sys.exit(1)
    src = Path(sys.argv[1]).resolve()
    if len(sys.argv) >= 3:
        out = Path(sys.argv[2]).resolve()
    else:
        out = src.with_name(src.stem + "-glow.pdf")
    html = out.with_suffix(".pdf.html")
    text = src.read_text()
    body = markdown.markdown(text, extensions=["fenced_code","tables","codehilite","toc","sane_lists"], extension_configs={"codehilite":{"guess_lang":False,"use_pygments":True,"css_class":"codehilite"}})
    full = f"""<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>{src.stem}</title><style>
html{{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
body{{margin:0;background:#1a1b26;color:#e6e6eb;font-family:-apple-system,'Segoe UI',Inter,sans-serif;font-size:13.5px;line-height:1.65;padding:56px 60px 80px 60px}}
.page{{max-width:860px;margin:0 auto}}
h1{{display:inline-block;font-family:monospace;font-size:20px;font-weight:700;color:#ffea00;background:#3d59a1;padding:4px 14px;border-radius:3px;margin:0 0 24px 0}}
h2{{font-family:monospace;font-size:16px;font-weight:700;color:#7dcfff;margin:36px 0 12px 0;padding-bottom:8px;border-bottom:1px dashed #3b3f5a}}
h3{{font-family:monospace;font-size:13.5px;color:#7aa2f7;margin:24px 0 10px 0}}
code{{font-family:monospace;font-size:12.5px;background:#353545;color:#f7768e;padding:2px 6px;border-radius:4px}}
pre{{background:#101014;border:1px solid #2a2e45;border-radius:8px;padding:18px 20px;overflow-x:auto}}
pre code{{background:transparent;padding:0;color:#e6e6eb;font-size:12.8px}}
.codehilite .s,.codehilite .s2{{color:#e0af68}} .codehilite .mi,.codehilite .mf,.codehilite .m{{color:#9ece6a}}
.codehilite .nt,.codehilite .nf{{color:#7aa2f7}} .codehilite .p{{color:#c0caf5}} .codehilite .k{{color:#ff79c6}}
table{{width:100%;border-collapse:collapse;margin:14px 0 20px 0;font-size:12.8px;font-family:monospace}}
thead th{{text-align:left;color:#fff;padding:8px 12px;border-bottom:1px solid #9aa0b8}}
tbody td{{padding:5px 12px;color:#e6e6eb}} tbody td:first-child code{{background:transparent;padding:0}}
hr{{border:none;border-top:1px dashed #3b3f5a;margin:28px 0}} ul{{padding-left:20px}}
@media print{{body{{padding:24px 28px}} pre,table{{break-inside:avoid}}}}
</style></head><body><div class="page">{body}</div></body></html>"""
    html.write_text(full)
    chrome = find_chrome()
    if not chrome:
        print("error: no Chrome/Chromium found for --print-to-pdf", file=sys.stderr); sys.exit(1)
    subprocess.run([chrome,"--headless","--no-sandbox","--disable-gpu",f"--print-to-pdf={out}","--no-pdf-header-footer",str(html)], capture_output=True)
    print(out)

if __name__ == "__main__":
    main()
